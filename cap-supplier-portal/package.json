{
  "name": "cap-supplier-portal",
  "version": "0.1.0",
  "private": true,
  "description": "CAP Supplier Portal for the Procurement Integration Hub. Phase 4.2 domain model.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds-tsx watch",
    "generate-types": "cds-typer \"*\" --outputDirectory @cds-models",
    "pretypecheck": "npm run generate-types",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate-types",
    "test": "node --import tsx --import ./test/cds-typescript.ts --test test/health.test.ts test/domain-model.test.ts test/integration-ingestion.test.ts test/supplier-service.test.ts test/supplier-ui.test.ts test/retry-policy.test.ts test/supplier-response-sender.test.ts test/cds-bootstrap.test.ts test/reconcile-supplier-response.test.ts test/operational-status.test.ts test/interactive-login-static.test.ts",
    "build:router": "node app/router/build.mjs",
    "flush-responses": "node --import tsx scripts/flush-supplier-responses.ts",
    "reconcile-response": "node --import tsx scripts/reconcile-supplier-response.ts",
    "operational-status": "node --import tsx scripts/operational-status.ts",
    "operational-status:prod": "node scripts/operational-status.js"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds": "^10.1.0",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.19.0",
    "@sap/cds-dk": "^10.1.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      }
    }
  }
}
