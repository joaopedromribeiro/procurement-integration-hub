managed implementation in class ZBP_I_PURCHASEORDER unique;
strict ( 2 );
with draft;

define behavior for ZJP_I_PurchaseOrder alias PurchaseOrder
persistent table zjp_po_h
draft table zjp_po_hd
lock master total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt

{
  create;

  update ( precheck );

  delete ( precheck );

  association _Items
  {
    create ( precheck );
    with draft;
  }


  action ( authorization : instance ) removeItem
    parameter ZJP_A_RemoveItem;


  action ( authorization : instance ) submit;


  action ( authorization : instance ) approve;


  action ( authorization : instance ) sendToSupplier;


  // Phase 7.6. EML-only operator recovery of the CURRENT UNKNOWN intent.
  // It is intentionally absent from every projection and performs no HTTP.

  action ( authorization : instance ) retryDelivery;


  // Phase 5.2g. The coordinator's outcome boundary. It is a NORMAL action and
  // deliberately not an internal action: the coordinator is an EXTERNAL EML
  // consumer running outside every handler, and internal would put it out of
  // reach. "Restricted" here means NOT PROJECTED - it is absent from
  // ZJP_C_PurchaseOrder, so no OData client can reach it, which is what
  // API_CONTRACTS means by "prefer EML-only access for coordinator bookkeeping;
  // do not expose an administrative HTTP operation just because a class uses it
  // internally". It exists because Status, IntegrationStatus, LastErrorCode,
  // LastErrorMessage, LastErrorAt and LastCorrelationId are all field
  // ( readonly ) below, so only a handler in local mode may write them.

  action ( authorization : instance ) recordDeliveryResult
    parameter ZJP_A_RecordDeliveryResult;


  // Phase 6.5b-1. The inbound boundary, and the mirror image of
  // recordDeliveryResult: SupplierResponse, EstimatedDeliveryDate,
  // SupplierRespondedAt, RejectionOrigin, RejectionReason, LastResponseId and
  // LastResponseVersion are all field ( readonly ), so only a handler in
  // LOCAL MODE can write them and an external caller needs a door with a lock
  // rather than an opening in the wall.
  //
  // A NORMAL action, not internal, for the same reason recordDeliveryResult
  // is: the caller is Cloud Integration through an OData binding, which is an
  // external consumer. It is deliberately NOT projected onto
  // ZJP_C_PurchaseOrder - the buyer UI must not answer on a supplier behalf,
  // and the integration surface is its own projection in Phase 6.5b-2.
  //
  // ONE action, not two. A supplier date update is an ACCEPTED response with a
  // higher ResponseVersion, which the version rules already order correctly; a
  // second action would need the same guards, the same idempotency receipt and
  // the same conflict rules, and would add a way for the two to disagree.

  action ( authorization : instance ) applySupplierResponse
    parameter ZJP_A_ApplySupplierResponse;


  action ( authorization : instance ) reject
    parameter ZJP_A_Reject;


  action ( authorization : instance ) cancel;


  draft action Edit;

  draft action Activate;

  draft action Discard;

  draft action Resume;


  draft determine action Prepare
  {
    validation validateSupplier;
    validation PurchaseOrderItem~validateQuantity;
    validation PurchaseOrderItem~validateNetPrice;
  }


  determination initializeStatus on modify
  {
    create;
  }


  validation validateSupplier on save
  {
    create;
    field Supplier;
  }


  field ( readonly, numbering : managed ) PurchaseOrderUUID;

  field ( readonly )
    PurchaseOrderNumber,
    SupplierName,
    TotalAmount,
    Status,
    SupplierResponse,
    EstimatedDeliveryDate,
    CreatedBy,
    CreatedAt,
    LastChangedBy,
    LastChangedAt,
    LocalLastChangedAt,
    OrderRevision,
    IntegrationStatus,
    DeliveryId,
    LastErrorCode,
    LastErrorMessage,
    LastErrorAt,
    LastCorrelationId,
    LastResponseId,
    LastResponseVersion,
    SupplierRespondedAt,
    RejectionOrigin,
    RejectionReason;


  mapping for zjp_po_h
  {
    PurchaseOrderUUID       = purchase_order_uuid;
    PurchaseOrderNumber     = purchase_order_number;
    Supplier                = supplier;
    SupplierName            = supplier_name;
    CompanyCode             = company_code;
    PurchasingOrganization  = purchasing_organization;
    PurchasingGroup         = purchasing_group;
    Currency                = currency;
    TotalAmount             = total_amount;
    Status                  = status;
    SupplierResponse        = supplier_response;
    EstimatedDeliveryDate   = estimated_delivery_date;
    CreatedBy               = created_by;
    CreatedAt               = created_at;
    LastChangedBy           = last_changed_by;
    LastChangedAt           = last_changed_at;
    LocalLastChangedAt      = local_last_changed_at;
    OrderRevision           = order_revision;
    IntegrationStatus       = integration_status;
    DeliveryId              = delivery_id;
    LastErrorCode           = last_error_code;
    LastErrorMessage        = last_error_message;
    LastErrorAt             = last_error_at;
    LastCorrelationId       = last_correlation_id;
    LastResponseId          = last_response_id;
    LastResponseVersion     = last_response_version;
    SupplierRespondedAt     = supplier_responded_at;
    RejectionOrigin         = rejection_origin;
    RejectionReason         = rejection_reason;
  }
}


define behavior for ZJP_I_PurchaseOrderItem alias PurchaseOrderItem
persistent table zjp_po_i
draft table zjp_po_id
lock dependent by _PurchaseOrder
authorization dependent by _PurchaseOrder
etag master LocalLastChangedAt

{
  update ( precheck );

  internal delete;

  association _PurchaseOrder
  {
    with draft;
  }


  determination calculateTotalAmount on modify
  {
    create;
    field Quantity, NetPrice;
  }


  validation validateQuantity on save
  {
    create;
    field Quantity;
  }


  validation validateNetPrice on save
  {
    create;
    field NetPrice;
  }


  field ( readonly, numbering : managed ) PurchaseOrderItemUUID;

  field ( readonly )
    PurchaseOrderUUID,
    TotalAmount,
    LocalLastChangedAt;


  mapping for zjp_po_i
  {
    PurchaseOrderItemUUID = purchase_order_item_uuid;
    PurchaseOrderUUID     = purchase_order_uuid;
    ItemNumber            = item_number;
    Material              = material;
    MaterialDescription   = material_description;
    Quantity              = quantity;
    UnitOfMeasure         = unit_of_measure;
    NetPrice              = net_price;
    Currency              = currency;
    TotalAmount           = total_amount;
    LocalLastChangedAt    = local_last_changed_at;
  }
}
