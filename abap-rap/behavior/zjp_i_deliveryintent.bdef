managed implementation in class ZBP_I_DELIVERYINTENT unique;
strict ( 2 );


define behavior for ZJP_I_DeliveryIntent alias DeliveryIntent
persistent table zjp_po_dlv
lock master
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;


  field ( readonly, numbering : managed ) DeliveryUUID;

  // Framework-maintained admin data.
  field ( readonly ) CreatedAt, LastChangedAt, LocalLastChangedAt;

  mapping for zjp_po_dlv
//mapping for zjp_po_dlv corresponding
  {
    DeliveryUUID       = delivery_uuid;
    PurchaseOrderUUID  = purchase_order_uuid;
    OrderRevision      = order_revision;
    PayloadSnapshot    = payload_snapshot;
    PayloadHash        = payload_hash;
    DispatchState      = dispatch_state;
    LastCorrelationId  = last_correlation_id;
    PortalOrderUUID    = portal_order_uuid;
    ApprovedBy         = approved_by;
    ApprovedAt         = approved_at;
    LeaseOwner         = lease_owner;
    LeaseExpiresAt     = lease_expires_at;
    CreatedAt          = created_at;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
    AttemptCount       = attempt_count;
    NextAttemptAt        = next_attempt_at;
    RetryWindowStartedAt = retry_window_started_at;
  }
}