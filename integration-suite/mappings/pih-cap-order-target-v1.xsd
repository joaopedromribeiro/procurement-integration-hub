<?xml version="1.0" encoding="UTF-8"?>
<!--
  PIH mapped CAP order contract, v1 - the TARGET schema of PIH_OrderDelivery_v1.

  STATUS: PROPOSED FOR PHASE 6.2. NOT DEPLOYED, NOT YET EXERCISED IN THE TENANT.
  Phase 6.1 stops at source validation and has no mapping step and no CAP call.

  DERIVATION, AND WHY NOTHING HERE IS INVENTED. Every element, type and length
  below comes from one of two authoritative places and from nowhere else:

    1. cap-supplier-portal/srv/integration-service.cds - the CAP ingestion
       contract that is locally runtime-verified in Phase 4.3, which fixes the
       element names AND the lengths (DecimalString is String(30), supplierCode
       String(10), product.code String(40), product.description String(100),
       source.system String(30), source.orderNumber String(20), currency and
       unit String(3), deliveryId String(36)).
    2. The Phase 5.2d golden CAP payload in ZJP_CL_BUILDER_TEST=>GOLDEN_BODY,
       which SAP runtime-verified byte for byte and which the deployed portal
       has accepted over real HTTP, which fixes the element ORDER.

  API_CONTRACTS.md's "Mapped CAP order" section agrees with both.

  ELEMENT ORDER IS PART OF THE CONTRACT HERE, even though JSON object order is
  not semantically meaningful, because Phase 6.2's parity test compares against
  the byte-exact ABAP output. Keeping xs:sequence in the ABAP mapper's order is
  what makes a byte comparison possible at all; if it turns out the XML-to-JSON
  converter reorders anything, the parity test falls back to a field-by-field
  semantic comparison and that fallback is documented rather than hidden.

  TWO CONVERSION RISKS ARE DELIBERATELY VISIBLE IN THIS FILE.

  (a) revision and lineNumber are xs:integer and MUST leave the iFlow as JSON
      NUMBERS - the CAP contract types them Integer and the golden body carries
      "revision":1 and "lineNumber":10 unquoted. Every other value is a string.
      An XML-to-JSON converter that stringifies everything breaks parity on
      exactly these two fields.

  (b) lines is maxOccurs="unbounded", and the golden fixture has exactly ONE
      line. A converter that renders a single repeated element as an object
      rather than a one-element array breaks parity on a payload that looks
      correct field by field. The parity test must assert that "lines" is an
      ARRAY, not merely that its contents match.

  Both are named in the Phase 6.2 plan as the things to prove first, because
  both produce output that reads as correct and is not.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <xs:simpleType name="DecimalStringType">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?[0-9]+(\.[0-9]+)?"/>
      <xs:maxLength value="30"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="UuidType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CurrencyType">
    <xs:restriction base="xs:string">
      <xs:length value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- CAP: InboundQuantity.unit is String(3). The controlled EA -> PCE value
       mapping produces PCE; an unmapped unit must fail rather than pass
       through, which is the mapping step's job, not this schema's. -->
  <xs:simpleType name="UnitType">
    <xs:restriction base="xs:string">
      <xs:length value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- CAP: InboundSource. Source identity is preserved SEPARATELY from any CAP
       UUID, which is why it is a nested object rather than flattened. -->
  <xs:complexType name="SourceType">
    <xs:sequence>
      <xs:element name="system"      type="xs:string"/>
      <xs:element name="orderId"     type="UuidType"/>
      <xs:element name="orderNumber" type="xs:string"/>
      <xs:element name="revision"    type="xs:integer"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CAP: InboundMoney. Used for both amount and unitPrice; currency first,
       matching the verified ABAP output. -->
  <xs:complexType name="MoneyType">
    <xs:sequence>
      <xs:element name="currency" type="CurrencyType"/>
      <xs:element name="value"    type="DecimalStringType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CAP: InboundProduct. -->
  <xs:complexType name="ProductType">
    <xs:sequence>
      <xs:element name="code"        type="xs:string"/>
      <xs:element name="description" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CAP: InboundQuantity. Value first, then unit - note this is the opposite
       order from MoneyType, and that is what the verified ABAP output emits. -->
  <xs:complexType name="QuantityType">
    <xs:sequence>
      <xs:element name="value" type="DecimalStringType"/>
      <xs:element name="unit"  type="UnitType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CAP: InboundLine. -->
  <xs:complexType name="LineType">
    <xs:sequence>
      <xs:element name="sourceItemId"    type="UuidType"/>
      <xs:element name="lineNumber"      type="xs:integer"/>
      <xs:element name="product"         type="ProductType"/>
      <xs:element name="orderedQuantity" type="QuantityType"/>
      <xs:element name="unitPrice"       type="MoneyType"/>
      <xs:element name="lineAmount"      type="DecimalStringType"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    Root name for the mapping target. The CAP receiver takes the JSON body at
    POST /rest/integration/v1/Orders, so the root element is stripped by the
    XML-to-JSON step and never appears on the wire; it exists only so the
    conversion, the validation and the mapping agree, which is precisely what
    ARCHITECTURE.md asks Phase 6 to settle.

    DELIBERATELY ABSENT, and each absence is a contract decision rather than an
    oversight: supplierName (CAP resolves its own supplier reference and will
    not take an untrusted overwrite), companyCode, purchasingOrganization and
    purchasingGroup (internal SAP context the portal does not need). The Phase
    6.2 parity test asserts these are ABSENT, not merely empty.
  -->
  <xs:element name="CapOrder">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="schemaVersion" type="xs:string"/>
        <xs:element name="deliveryId"    type="UuidType"/>
        <xs:element name="source"        type="SourceType"/>
        <xs:element name="supplierCode"  type="xs:string"/>
        <xs:element name="amount"        type="MoneyType"/>
        <xs:element name="lines"         type="LineType" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
